<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Chris, Your Man with a Van" />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow" />
    <meta name="language" content="English" />
    <meta name="geo.region" content="GB-AYS" />
    <meta name="geo.placename" content="Cumnock, Ayrshire, Scotland" />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonical} />
    
    <!-- Hreflang for UK targeting -->
    <link rel="alternate" hreflang="en-gb" href={canonical} />
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    
    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/maple-leaf.svg" />
    <link rel="alternate icon" href="/vanlogo.png" />
    
    <!-- Critical CSS - Inlined -->
    <style id="critical-css" is:inline>
      :root{--sunshine-yellow:51 85% 60%;--primary-orange:19 67% 49%;--dark-orange:19 67% 39%;--background:0 0% 0%;--foreground:0 0% 100%;--card:0 0% 10%;--card-foreground:0 0% 100%;--primary:19 67% 49%;--primary-foreground:0 0% 100%;--muted:0 0% 15%;--muted-foreground:0 0% 80%;--border:0 0% 20%;--radius:1rem}*{box-sizing:border-box;margin:0;padding:0;border:0}html{overflow-x:hidden;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}body{margin:0;padding:0;background-color:hsl(var(--background));color:hsl(var(--foreground));font-family:system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;line-height:1.5;overflow-x:hidden;-webkit-overflow-scrolling:touch}nav{position:fixed;top:0;width:100%;z-index:50;transition:all .3s ease-in-out}#hero{min-height:100vh;position:relative;display:flex;align-items:center;background-color:#000;overflow:hidden}#root{min-height:100vh}img{max-width:100%;height:auto;display:block}button{cursor:pointer;font-family:inherit}.font-display{font-family:'Outfit',system-ui,sans-serif}
    </style>

    <!-- Preconnect to external domains early -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <!-- Preload critical resources -->
    <link rel="preload" href="/back1.webp" as="image" type="image/webp" fetchpriority="high" />
    <link rel="preload" href="/vanlogo.webp" as="image" type="image/webp" fetchpriority="high" />
    <link rel="preload" href="/vanlogo.png" as="image" type="image/png" fetchpriority="high" />
    
    <!-- Defer non-critical CSS - Google Fonts -->
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Poppins:wght@400;500;600;700&display=swap" as="style" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <!-- Preconnect to Netlify for faster resource loading -->
    <link rel="dns-prefetch" href="https://chrismanwithvanstaging.netlify.app" />
    <link rel="preconnect" href="https://chrismanwithvanstaging.netlify.app" crossorigin />
    
    <!-- Preconnect to Google Maps API -->
    <link rel="dns-prefetch" href="https://maps.googleapis.com" />
    <link rel="preconnect" href="https://maps.googleapis.com" />

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Chris, Your Man with a Van" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>

  <body>
    <slot />
    
    <!-- Analytics Scripts - Load after page render -->
    <script is:inline>
      // Load analytics after page load
      window.addEventListener('load', function() {
        // Google Analytics - defer loading
        const script1 = document.createElement('script');
        script1.async = true;
        script1.src = 'https://www.googletagmanager.com/gtag/js?id=G-V7YSJ55C9T';
        document.head.appendChild(script1);
        
        script1.onload = function() {
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-V7YSJ55C9T');
        };

        const script2 = document.createElement('script');
        script2.async = true;
        script2.src = 'https://www.googletagmanager.com/gtag/js?id=G-L1XB9GKZ7E';
        document.head.appendChild(script2);
        
        script2.onload = function() {
          if (!window.dataLayer) window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-L1XB9GKZ7E');
        };

        // RevuCapture Analytics - defer
        const revuScript = document.createElement('script');
        revuScript.src = '/simple-tracker.js';
        revuScript.setAttribute('data-website-id', 'chris-van-services');
        revuScript.async = true;
        document.head.appendChild(revuScript);
      });
    </script>
  </body>
</html>

